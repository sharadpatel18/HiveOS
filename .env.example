# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/[your-project-name]"

# JWT secrets
# Keep these long and random in your real .env
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"

# Legacy names still used by app/api/auth/refresh/route.ts
# Set them to the same values as the JWT_* secrets above
ACCESS_TOKEN_SECRET="replace-with-a-long-random-access-secret"
REFRESH_TOKEN_SECRET="replace-with-a-long-random-refresh-secret"

# App URL used in invite emails
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Email / SendGrid
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@example.com"
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"